# === ОБЯЗАТЕЛЬНЫЕ НАСТРОЙКИ ===

# OpenRouter API ключ для внешних нейронок (ОБЯЗАТЕЛЬНО)
# Получить можно на https://openrouter.ai/
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxx

# === ОПЦИОНАЛЬНЫЕ НАСТРОЙКИ ===

# Среда выполнения (development, production, test)
NODE_ENV=production

# Уровень логирования (DEBUG, INFO, WARN, ERROR)
LOG_LEVEL=INFO

# URL для OpenRouter API (по умолчанию: https://openrouter.ai/api/v1)
OPENROUTER_API_URL=https://openrouter.ai/api/v1

# Таймаут запросов в миллисекундах (по умолчанию: 30000)
REQUEST_TIMEOUT=30000

# Версия MCP протокола (по умолчанию: 2024-11-05)
MCP_PROTOCOL_VERSION=2024-11-05

# Версия MCP сервера (по умолчанию: из package.json)
MCP_SERVER_VERSION=2.0.0

# Путь к промптам (по умолчанию: prompts относительно пакета)
PROMPTS_PATH=prompts

# Модель AI по умолчанию (по умолчанию: openai/gpt-oss-120b)
DEFAULT_AI_MODEL=openai/gpt-oss-120b

# === ДОПОЛНИТЕЛЬНЫЕ НАСТРОЙКИ ВАЛИДАЦИИ ===

# Таймаут валидации в миллисекундах (по умолчанию: 30000)
VALIDATION_TIMEOUT=30000

# Таймаут для параллельного тестирования промптов в миллисекундах (по умолчанию: 120000)
PARALLEL_TEST_TIMEOUT=120000

# === НАСТРОЙКИ ДЛЯ РАЗРАБОТКИ ===

# Флаг тестового режима (true/false, по умолчанию: false)
IS_TEST_MODE=false

# Флаг E2E тестирования (true/false, по умолчанию: false)
MCP_E2E_TEST=false

# NODE_PATH для разрешения модулей (опционально)
NODE_PATH=

# === НАСТРОЙКИ MCP СЕРВЕРА ===

# Имя MCP сервера (по умолчанию: mcp-validator)
MCP_SERVER_NAME=mcp-validator

# Описание MCP сервера (по умолчанию: Production-ready MCP validator)
MCP_SERVER_DESCRIPTION=Production-ready MCP validator for Cursor IDE with 4 validation types

# === РАСШИРЕННЫЕ НАСТРОЙКИ ===

# Максимальное количество параллельных запросов (по умолчанию: 5)
MAX_PARALLEL_REQUESTS=5

# Интервал heartbeat в миллисекундах для поддержания MCP соединения (по умолчанию: 30000)
HEARTBEAT_INTERVAL=30000

# Размер буфера для MCP запросов в байтах (по умолчанию: 1048576 = 1MB)
REQUEST_BUFFER_SIZE=1048576