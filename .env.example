# === ОБЯЗАТЕЛЬНЫЕ НАСТРОЙКИ ===

# API ключ для OpenAI-совместимого провайдера (ОБЯЗАТЕЛЬНО)
# По умолчанию используется OpenRouter, но можно использовать любой OpenAI-совместимый API
# Получить можно на https://openrouter.ai/ или у другого провайдера
API_KEY=sk-or-v1-xxxxxxxxxxxxxx

# === НАСТРОЙКИ AI МОДЕЛИ ===

# Модель AI для валидации и тестирования (по умолчанию: openai/gpt-oss-20b:free)
AI_MODEL=openai/gpt-oss-20b:free

# Максимальное количество токенов для AI ответа (по умолчанию: 100000)
AI_MAX_TOKENS=100000

# Температура генерации AI (0-2, по умолчанию: 0.5)
AI_TEMPERATURE=0.5

# === НАСТРОЙКИ API ===

# URL для OpenAI-совместимого API (по умолчанию: https://openrouter.ai/api/v1)
# Поддерживается OpenRouter, OpenAI, Anthropic Claude и другие совместимые провайдеры
API_URL=https://openrouter.ai/api/v1

# === НАСТРОЙКИ ТАЙМАУТОВ ===

# Таймаут для API запросов в миллисекундах (по умолчанию: 30000)
TIMEOUT_API_REQUEST=30000

# Таймаут для процесса валидации в миллисекундах (по умолчанию: 30000)
TIMEOUT_VALIDATION=30000

# === ОСНОВНЫЕ НАСТРОЙКИ ===

# Среда выполнения (development, production, test)
NODE_ENV=production

# Уровень логирования (DEBUG, INFO, WARN, ERROR)
LOG_LEVEL=INFO

# Путь к промптам (по умолчанию: prompts относительно пакета)
PROMPTS_PATH=prompts

# === НАСТРОЙКИ СРЕДЫ ВЫПОЛНЕНИЯ ===

# Флаг E2E тестирования (true/false, по умолчанию: false)
MCP_E2E_TEST=false

# NODE_PATH для разрешения модулей (опционально)
NODE_PATH=

# === НАСТРОЙКИ MCP СЕРВЕРА ===


# === РАСШИРЕННЫЕ НАСТРОЙКИ ===

# Максимальное количество параллельных запросов (по умолчанию: 5)
MAX_PARALLEL_REQUESTS=5

# Интервал heartbeat в миллисекундах для поддержания MCP соединения (по умолчанию: 30000)
HEARTBEAT_INTERVAL=30000

# Размер буфера для MCP запросов в байтах (по умолчанию: 1048576 = 1MB)
REQUEST_BUFFER_SIZE=1048576
