{
  "name": "mcp-validator",
  "version": "0.2.0",
  "description": "MCP Validator - инструмент для валидации кода, тестов и архитектуры через AI",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "bin": {
    "mcp-validator": "lib/index.js"
  },
  "files": [
    "lib",
    "prompts",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "mcp",
    "validator",
    "ai",
    "code-quality",
    "testing"
  ],
  "packageManager": "yarn@1.22.22",
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/CyberWalrus/mcp-validator.git"
  },
  "author": "Andrey Pakhomov",
  "license": "MIT",
  "scripts": {
    "start": "node --env-file=.env --import tsx src/index.ts",
    "build": "tsup",
    "prepublishOnly": "yarn build && yarn test && yarn lint",
    "test": "yarn test:unit && yarn test:e2e",
    "test:unit": "vitest --run",
    "test:e2e": "NODE_ENV=test MCP_E2E_TEST=true vitest --config vitest.e2e.config.ts --run",
    "lint": "yarn eslint --fix --report-unused-disable-directives-severity off src && yarn typecheck",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.20.0",
    "openai": "6.3.0",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@types/node": "24.7.2",
    "@vitest/coverage-v8": "3.2.4",
    "eslint-walrus-config": "1.0.1",
    "tsup": "8.5.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}