{
  "name": "mcp-validator",
  "version": "0.7.8",
  "description": "MCP Validator - инструмент для валидации кода, тестов и архитектуры через AI",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "bin": {
    "mcp-validator": "lib/index.js"
  },
  "files": [
    "lib",
    "prompts",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "mcp",
    "validator",
    "ai",
    "code-quality",
    "testing"
  ],
  "packageManager": "yarn@1.22.22",
  "engines": {
    "node": ">=16.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/CyberWalrus/mcp-validator.git"
  },
  "author": "Andrey Pakhomov",
  "license": "MIT",
  "scripts": {
    "start": "node --import tsx src/index.ts",
    "build": "tsup",
    "test": "yarn test:unit && yarn test:e2e",
    "lint": "aifr \"yarn lint:eslint\" \"yarn lint:ts\" \"yarn lint:knip\" \"yarn lint:test-unit\" \"yarn lint:test-e2e\"",
    "lint:test-unit": "cross-env NODE_ENV=test vitest --run",
    "lint:test-e2e": "yarn build && cross-env NODE_ENV=test MCP_E2E_TEST=true vitest --config vitest.e2e.config.ts --run",
    "lint:ts": "tsc --noEmit",
    "lint:eslint": "yarn eslint --fix --report-unused-disable-directives-severity off src",
    "lint:knip": "knip --no-progress --include exports,files"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.24.3",
    "dotenv": "17.2.3",
    "openai": "6.10.0",
    "undici": "7.16.0",
    "zod": "4.1.13"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@vitest/coverage-v8": "4.0.15",
    "ai-friendly-runner": "0.4.2",
    "cross-env": "10.1.0",
    "eslint-walrus-config": "1.1.0",
    "knip": "5.71.0",
    "tsup": "8.5.1",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vitest": "4.0.15"
  }
}