{
  "name": "mcp-validator",
  "version": "1.0.0",
  "main": "index.js",
  "repository": "git@github.com:CyberWalrus/mcp-validator.git",
  "author": "Пахомов Андрей Николаевич <andrey.pahomov@ligastavok.ru>",
  "license": "MIT",
  "scripts": {
    "start": "node --env-file=.env --import tsx src/index.ts",
    "test": "yarn test:unit && yarn test:e2e",
    "test:unit": "vitest --run",
    "test:e2e": "NODE_ENV=test MCP_E2E_TEST=true vitest --config vitest.e2e.config.ts --run",
    "lint": "yarn eslint --fix --report-unused-disable-directives-severity off src && yarn typecheck",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.20.0",
    "@openai/agents": "0.1.9",
    "openai": "6.3.0",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@types/node": "24.7.2",
    "@vitest/coverage-v8": "3.2.4",
    "eslint-walrus-config": "1.0.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}